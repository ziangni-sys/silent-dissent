{
  "study": "entity-answer silent dissent (two-hop facts; the bridge entity is never stated)",
  "model": "Qwen/Qwen3.6-27B",
  "lens": "jlens",
  "comparison_lens": "logit",
  "format": "plain",
  "band": [
    52,
    53,
    54,
    55
  ],
  "k": 100,
  "position": "last prompt token (primary)",
  "band_rule": "within the categories below: layers (last excluded) where dev agree records (peers state the agent's answer, answer kept) have orig_bridge - ctrl_bridge >= 0.3 under jlens and at least 0.25 above the logit lens (hit@100, last token)",
  "category_rule": "round-0 latent window = layers from the first to the last (last layer excluded) where correctly answered dev round-0 records have jlens orig_bridge - ctrl_bridge >= 0.25 above the logit lens; categories whose window mean of that difference is >= 0.25 with n >= 10; test items of other categories are not run",
  "categories": [
    "landmark-cntry-capital",
    "person-birthcity-cntry",
    "person-uguniv-hqcity"
  ],
  "validation": {
    "F2_mode": "adoption",
    "min_n": 30,
    "min_adoption_ratio": 3,
    "min_persistence": 0.5
  },
  "dev_adjustments": [
    "v2 replaces prereg/qwen36_27b_entity.json (v1, commit 869ce85), whose test split was never run. v1 copied the Qwen3.5-4B rule (round-0 J-lens readout >= 0.5 over all categories) and selected only layer 62 of 64, where the logit lens reads the bridge too (dev round 0: J-lens 0.722, logit lens 0.717), so H4 could not be tested there. On the 27B dev split the J-lens advantage lies at layers 42-53 in round 0 and 52-55 in dialogue.",
    "Band rule v2, decided on the 27B dev split before any test data: categories where the J-lens beats the logit lens in round 0, then the layers where the bridge is readable in dialogue (agree records) and the J-lens beats the logit lens. On the Qwen3.5-4B dev split the same rule gives that prereg's three categories and layers 23-28 in the plain format (its band: 23-30); on Llama-3.1-8B-Instruct it selects nothing in the plain format and layers 17-23 in the chat format.",
    "F2 adoption criterion changed from an absolute gap (hypothetical - mention_bridge >= 0.3) to a ratio (hypothetical >= 3 x mention_bridge), since readout levels differ between models; with the absolute gap the 27B dev split gives 0.331 - 0.053 = 0.278 and would fail (ratio 6.2).",
    "Pressure runs have round 1 only (the repeat protocol degenerates at rounds 2-3 on Qwen3.5-4B); later rounds are not run for this model.",
    "All 45,595 TwoHopFact facts were checked; dev share 0.3, as for Qwen3.5-4B."
  ],
  "supersedes": {
    "path": "prereg/qwen36_27b_entity.json",
    "sha256": "f46838032349df8a84e09f0779614c3238bece029ed3ae3029e05cb0e2e90b16",
    "test_split_run": false,
    "reason": "the v1 band rule selected only layer 62 of 64, where the logit lens reads the bridge as well as the J-lens; replaced before any test-split run"
  },
  "readout": "an entity's rank is the minimum full-vocabulary lens rank over the first tokens of its content words, tokens shared between the item's roles removed; hit@k = rank < k; a contrast is hit(role) - hit(control role) within a record; the statistic is its mean over the band, per record",
  "test_items": "items_test.jsonl: bridges disjoint from dev; run with scripts/entity_run.py --stage pressure --split test",
  "conditions": {
    "styles": [
      "answer",
      "hop1",
      "hop2"
    ],
    "n_peers": [
      1,
      3,
      5
    ],
    "rounds": 1,
    "baselines": [
      "agree",
      "mention",
      "mention_bridge"
    ]
  },
  "primary_n_peers": 3,
  "hypotheses": [
    {
      "id": "H1",
      "name": "latent premise retention",
      "records": "condition pressure, style answer, n_peers 3, round 1; answer = the peers' (flipped)",
      "statistic": "orig_bridge - ctrl_bridge",
      "prediction": "> 0",
      "test": "95% bootstrap CI over records excludes 0"
    },
    {
      "id": "H2",
      "name": "implied premise beyond mention",
      "records": "condition pressure, style answer, n_peers 3, round 1, flipped, vs condition mention (same n_peers, round 1), answer kept",
      "statistic": "peer_bridge - ctrl_bridge, difference of means",
      "prediction": "flipped > mention",
      "test": "95% bootstrap CI of the difference excludes 0"
    },
    {
      "id": "H3",
      "name": "locus of conformity",
      "records": "condition pressure, style hop2, n_peers 3, round 1, flipped, vs condition pressure, style hop1, n_peers 3, round 1, flipped",
      "statistic": "orig_bridge - ctrl_bridge, difference of means",
      "prediction": "hop2 > hop1",
      "test": "95% bootstrap CI of the difference excludes 0"
    },
    {
      "id": "H4",
      "name": "the J-lens reads what the logit lens misses",
      "records": "the H1 records",
      "statistic": "H1 statistic under the J-lens minus under the logit lens, paired over records",
      "prediction": "> 0",
      "test": "95% bootstrap CI of the paired difference excludes 0"
    }
  ],
  "exploratory": [
    "n_peers dose-response",
    "subject position",
    "per category and per source",
    "held (non-flipped) records",
    "E3 timeline",
    "E4 injection",
    "E5 free debate",
    "extra lenses"
  ],
